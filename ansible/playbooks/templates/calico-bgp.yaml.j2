# DO NOT EDIT THIS FILE DIRECTLY
# This file is generated from a Jinja2 template located at:
# ansible/playbooks/templates/calico-bgp.yaml.j2
---
apiVersion: projectcalico.org/v3
kind: BGPConfiguration
metadata:
  name: default
spec:
  logSeverityScreen: Info
  nodeToNodeMeshEnabled: true
  asNumber: 65000
{% for address in haproxy_ip_list %}
---
# ingress controller server
apiVersion: projectcalico.org/v3
kind: BGPPeer
metadata:
  name: haproxy-{{ address | replace('.', '-') }}
spec:
  peerIP: {{ address }}
  asNumber: 65000
{% endfor %}
