# terraform/modules/aws/haproxy/templates/keepalived_conf.tmpl

# Global Settings for notifications
global_defs {
    # notification_email {
    #     id@domain.com     # Email address for notifications 
    # }
    # notification_email_from id@domain.com	# The from address for the notifications
    # smtp_server 127.0.0.1     			# SMTP server address
    # smtp_connect_timeout 15
    enable_script_security
    script_user root
}
  
# Define the script used to check if haproxy is still working
vrrp_script chk_haproxy { 
    script "/usr/bin/killall -0 haproxy"     # Check if haproxy is running (requires root)
    interval 2 
    weight 0
}
  
# Configuration for Virtual Interface
vrrp_instance LB_VIP {
    interface ${interface_name}		# Network interface to bind to
    
%{ if priority == 101 }
    state MASTER 
%{ else }
    state BACKUP
%{ endif }
    priority ${priority} # Allow differn priorites for multiple backups
    
    virtual_router_id 51
  
    # smtp_alert          # Enable Notifications Via Email
  
    authentication {
        auth_type PASS
        auth_pass ${keepalived_secret}	# Password for accessing vrrpd. Same on all devices
    }
    unicast_src_ip ${src_ip} # Private IP address of master
    unicast_peer {
${peer_ips}		# Private IP address of the backup haproxy
   }
  
    # The virtual ip address shared between the two loadbalancers
    virtual_ipaddress {
        ${virtual_ip}
    }
     
    # Use the Defined Script to Check whether to initiate a fail over
    track_script {
        chk_haproxy
    }

    notify_master "/etc/keepalived/attach_eip.sh"
}
